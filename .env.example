# ---- Container images
POSTGRES_IMAGE="docker.io/postgres:18-alpine"
FLYWAY_IMAGE="docker.io/flyway/flyway:12-alpine"
OTEL_LGTM_IMAGE="docker.io/grafana/otel-lgtm:0.11.10"
OTEL_COLLECTOR_IMAGE="docker.io/otel/opentelemetry-collector-contrib:0.110.0"
APP_IMAGE="ghcr.io/baseledger-io/baseledger:latest"
NODE_EXPORTER_IMAGE="docker.io/prom/node-r:v1.8.1"
POSTGRES_EXPORTER_IMAGE="docker.io/prometheuscommunity/postgres-r:v0.15.0"
CADVISOR_IMAGE="gcr.io/cadvisor/cadvisor:v0.49.1"

# ---- HTTP
HTTP_HOST="0.0.0.0"
HTTP_PUBLISHED_PORT=8000

# ---- Database connection
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5433
POSTGRES_DB="postgres"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_PUBLISHED_PORT=5433

# ---- Pekko
PEKKO_REMOTE_HOSTNAME="127.0.0.1"
PEKKO_REMOTE_PORT="2551"
PEKKO_LOGLEVEL="WARNING"
PEKKO_NUMBER_OF_SHARDS=100
PASSIVATE_IDLE_ENTITY_AFTER=5m

# ---- HTTP Server Performance / Throughput Tuning
HTTP_SERVER_BACKLOG=65535               # accept queue only; no CPU cost
HTTP_SERVER_MAX_CONNECTIONS=32768       # a cap, not an allocation
HTTP_SERVER_HTTP2_MAX_CONCURRENT_STREAMS=512
HTTP_SERVER_PIPELINING_LIMIT=64
HTTP_SERVER_ENABLE_HTTP2="on"
HTTP_SERVER_REQUEST_TIMEOUT=30s
HTTP_SERVER_USE_DISPATCHER="http-dispatcher"

# ---- HTTP Server Dispatcher Tuning
HTTP_DISPATCHER_PARALLELISM_MIN=16
HTTP_DISPATCHER_PARALLELISM_FACTOR=1
HTTP_DISPATCHER_PARALLELISM_MAX=32
HTTP_DISPATCHER_THROUGHPUT=200

# ---- R2DBC Connection Pool Tuning
R2DBC_POOL_MAX_SIZE=16
R2DBC_POOL_INITIAL_SIZE=16
READ_R2DBC_POOL_MAX_SIZE=16
READ_R2DBC_POOL_INITIAL_SIZE=16

# ---- DB Journal Write batching
EVENTS_BATCH_WRITE_WINDOW=5ms
EVENTS_BATCH_QUEUE_SIZE=200000 
EVENTS_BATCH_PARALLELISM=8
EVENTS_BATCH_MAX_REQUESTS=10000

# ---- Projection Dispatcher Tuning
PROJECTION_DISPATCHER_FIXED_POOL_SIZE=8

# ---- Persistence (write) Dispatcher Tuning
WRITE_PERSISTENCE_DISPATCHER_FIXED_POOL_SIZE=8

# ---- Pekko Default Dispatcher Tuning
PEKKO_DEFAULT_DISPATCHER_PARALLELISM_FACTOR=1
PEKKO_DEFAULT_DISPATCHER_PARALLELISM_MAX=8
PEKKO_DEFAULT_DISPATCHER_THROUGHPUT=200

# ---- OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_TRACES_SAMPLER="parentbased_traceidratio"
OTEL_TRACES_SAMPLER_ARG="0.05"          # drop to 0.02 if you see GC/CPU pressure

#
PROJECTION_INSTANCES=2
# ---- Projection: dedicated R2DBC pool
PROJECTION_R2DBC_POOL_INITIAL_SIZE=4
PROJECTION_R2DBC_POOL_MAX_SIZE=8
